#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------
// |ESC | 1  | 2  | 3  | 4  | 5  |   | 6  | 7  | 8  | 9  | 0  |DEL |
// |TAB | Q  | W  | E  | R  | T  |   | Y  | U  | I  | O  | P  |HOME|
// |CAPS| A  | S  | D  | F  | G  |   | H  | J  | K  | L  | ;  |PGUP|
// |LSFT| Z  | X  | C  | V  | B  |   | N  | M  | ,  | .  | /  |PGDN|
// |LCTL|LALT|LGUI|                                 |RALT|RCTL|END |
//                |MO1 |LANG|SPC |   |BSPC|RET |MO1 | B  |
            bindings = <
&kp ESC   &kp N1   &kp N2    &kp N3    &kp N4    &kp N5      &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
&kp TAB   &kp Q    &kp W     &kp E     &kp R     &kp T       &kp Y     &kp U     &kp I     &kp O     &kp P     &kp DEL
&kp CAPS  &kp A    &kp S     &kp D     &kp F     &kp G       &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp RET
&kp LSHFT &kp Z    &kp X     &kp C     &kp V     &kp B       &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL &kp LALT &kp LGUI  &none     &none     &none       &none     &none     &none     &kp RALT  &kp RCTRL &mo 1
                             &kp UNDER     &kp SPACE &mo 1   &kp PSCRN  &kp SPACE   &kp LANG1    &kp B
            >;
        };

        lower_layer {
            bindings = <
&kp F1   &kp F2  &kp F3    &kp F4    &kp F5    &kp F6                   &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp BSPC
&trans   &kp HOME   &kp UP    &kp END    &trans   &trans                &mkp MCLK      &kp KP_N7    &kp KP_N8    &kp KP_N9   &kp KP_PLUS        &kp KP_COMMA
&trans   &kp LEFT   &kp DOWN    &kp RIGHT    &trans   &trans            &mkp RCLK     &kp KP_N4    &kp KP_N5    &kp KP_N6   &kp KP_MINUS       &kp KP_DOT 
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans  &trans        &mkp LCLK   &kp KP_N1    &kp KP_N2    &kp KP_N3    &kp KP_MULTIPLY        &kp KP_ENTER
&trans   &trans  &trans    &trans    &trans    &trans      &trans       &trans    &trans    &kp KP_N0    &kp KP_DIVIDE      &tog 2
                            &trans    &trans    &trans      &trans      &trans    &trans   &trans
            >;
        };

        lower_layer2 {
            bindings = <
&trans     &trans       &trans       &trans       &trans    &trans       &trans    &trans    &trans    &trans       &trans      &trans
&trans     &trans       &trans       &trans       &trans    &trans       &trans    &trans    &kp UP    &trans       &trans      &trans
&trans     &trans       &trans       &trans       &trans    &trans       &trans    &kp LEFT    &kp DOWN    &kp RIGHT       &trans      &trans
&trans     &trans       &trans       &trans       &trans    &trans       &trans    &trans    &trans    &trans       &trans      &trans
&trans     &trans       &trans       &trans       &trans    &trans       &trans    &trans    &trans    &trans       &trans      &trans
                                     &trans       &trans    &trans       &trans    &trans    &trans    &trans
            >;
        };
    };
};
